    "firebase-admin": "^14.2.0",
    "i18next": "^24.2.2",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.546.0",
    "motion": "^13.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^15.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
