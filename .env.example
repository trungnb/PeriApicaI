# Gemini / Google AI
GEMINI_API_KEY=
zknjght_key=

# Required server credentials
ADMIN_PASSWORD=
DEL_PASSWORD=
PILOT_REVIEWER_IDS=

# Stable signing secrets (required in production/staging)
INFERENCE_LINEAGE_SIGNING_SECRET=
VALIDITY_RECEIPT_SIGNING_SECRET=

# Optional Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT=

# Optional Google OAuth client
VITE_GOOGLE_CLIENT_ID=

# Trusted reverse-proxy hop count. Keep 0 when directly exposed.
TRUST_PROXY=0

# Optional test switch
RUN_LIVE_AI_TESTS=false
