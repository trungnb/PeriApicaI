NODE_ENV=production
DEPLOYMENT_ENV=production
PORT=3000
DISABLE_HMR=true

# Required for Gemini-backed inference; set as a server-side secret.
GEMINI_API_KEY=

# Optional legacy/secondary server-side Gemini key.
zknjght_key=

# Optional Firebase Admin credentials for durable shared persistence.
FIREBASE_SERVICE_ACCOUNT=
# Alternative: path to credentials supplied by the hosting environment.
GOOGLE_APPLICATION_CREDENTIALS=

# Required in production when signed lineage/validity receipts are enabled.
INFERENCE_LINEAGE_SIGNING_SECRET=
VALIDITY_RECEIPT_SIGNING_SECRET=

# Admin and destructive-action credentials.
ADMIN_PASSWORD=
DEL_PASSWORD=
PILOT_REVIEWER_IDS=

# Use 0 when directly exposed; use true or a numeric hop count behind a trusted proxy.
TRUST_PROXY=0
ALLOW_VALIDITY_PROTOTYPE_OVERRIDE=false

# Optional OAuth client configuration.
# VITE_GOOGLE_CLIENT_ID=
