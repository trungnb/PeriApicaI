# .env.example

# Primary/Fallback API Key (Secret prioritized key)
zknjght_key=

# Optional: Google Gemini API key for AI-powered X-ray analysis features
GEMINI_API_KEY=

# Password required to log in to the admin portal (stored in secrets)
ADMIN_PASSWORD=

# Password required to delete data in the admin portal (stored in secrets)
DEL_PASSWORD=

# Optional: Firebase Service Account JSON string for Firestore sync
FIREBASE_SERVICE_ACCOUNT=

# Google OAuth Client ID for exporting data to Google Sheets
VITE_GOOGLE_CLIENT_ID=
